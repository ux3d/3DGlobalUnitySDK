<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <uie:PropertyField name="configCode" binding-path="configCode" />
    <ui:VisualElement name="Divider" style="flex-grow: 1; margin-bottom: 20px;" />
    <uie:PropertyField binding-path="mode" name="mode" />
    <ui:VisualElement name="Divider" style="flex-grow: 1; margin-bottom: 20px;" />
    <uie:PropertyField name="dataType" binding-path="dataType" />
    <uie:PropertyField name="renderTexture" binding-path="renderTexture" />
    <uie:PropertyField name="image" binding-path="image" />
    <uie:PropertyField name="videoClip" binding-path="videoClip" />
    <ui:VisualElement name="Divider" style="flex-grow: 1; margin-bottom: 20px;" />
    <uie:PropertyField name="mosaicRowCount" binding-path="mosaicRowCount" />
    <uie:PropertyField name="mosaicColumnCount" binding-path="mosaicColumnCount" />
    <uie:PropertyField name="dimensionsFromFilename" binding-path="dimensionsFromFilename" />
    <ui:VisualElement name="Divider" style="flex-grow: 1; margin-bottom: 20px;" />
    <ui:Foldout text="Advanced" enabled="true" value="false" name="AdvancedSettings">
        <uie:PropertyField name="viewOffset" binding-path="viewOffset" />
        <uie:PropertyField name="indexMapYoyoStart" binding-path="indexMapYoyoStart" />
        <uie:PropertyField name="invertIndexMap" binding-path="invertIndexMap" />
        <uie:PropertyField name="invertIndexMapIndices" binding-path="invertIndexMapIndices" />
        <ui:Foldout text="Index Map" enabled="true" value="false" name="IndexMapDisplay">
            <ui:Label text="" name="IndexMap" />
        </ui:Foldout>
        <uie:PropertyField name="shouldRenderMosaic" binding-path="shouldRenderMosaic" />
    </ui:Foldout>
    <ui:VisualElement name="Divider" style="flex-grow: 1; margin-bottom: 20px;" />
    <ui:Button text="Visit online documentation" name="visitOnlineDocumentation"/>
</ui:UXML>
